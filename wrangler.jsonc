{
  "name": "lillofind",
  "main": "cloudflare-worker/src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Catalogo dello shop (0 letture Firestore per visita): spazio KV "lillofind-catalog".
  "kv_namespaces": [
    { "binding": "CATALOG", "id": "7607b12a95ff47bda2c646e1b9806048" }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "lillofind-c455c",
    "ALLOWED_ORIGINS": "https://lillofind.shop,https://www.lillofind.shop,https://lillofind-c455c.web.app,https://lillofind-c455c.firebaseapp.com,http://localhost:8000,http://localhost:5000",
    "ADMIN_EMAILS": "yishionvt@gmail.com,admin@lillofind.com",
    "RESEND_FROM": "LilloFind <noreply@lillofind.shop>",
    "WORKER_PUBLIC_BASE": "https://lillofind.conti9708.workers.dev"
  }
}
