rules_version = '2';
// Deploy automatico via GitHub Actions (firebase-deploy.yml) ad ogni push su main.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin determinato dall'email autenticata (allowlist), NON da un campo del
    // documento utente: quel campo è scrivibile dall'utente stesso e non deve
    // conferire privilegi. Le email admin sono uniche in Firebase Auth
    // (nessun altro può registrarle) → nessuna auto-promozione possibile.
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email in ['yishionvt@gmail.com', 'admin@lillofind.com'];
    }

    // Impedisce all'utente di scriversi isAdmin:true sul proprio documento
    // (difesa in profondità: le regole non lo usano, ma evita confusione).
    function noSelfAdmin() {
      return !('isAdmin' in request.resource.data)
        || request.resource.data.isAdmin == resource.data.get('isAdmin', false);
    }

    // Products — lettura pubblica, scrittura solo admin
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — utente legge i propri, admin legge/scrive tutti
    match /orders/{id} {
      allow read:   if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Users — utente legge/scrive il proprio doc, admin legge tutti
    match /users/{uid} {
      allow read:  if request.auth.uid == uid || isAdmin();
      allow write: if isAdmin() || (request.auth.uid == uid && noSelfAdmin());
    }

    // Richieste prodotto ("non trovo prodotto") — chiunque può inviare, solo admin legge
    match /product_requests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Avvisami quando disponibile — chiunque può iscriversi, solo admin legge
    match /stock_alerts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Analytics presenza — ogni visitatore scrive la propria sessione (heartbeat),
    // solo l'admin legge. Create/update pubblici (anche non loggati) ma con
    // validazione di forma/dimensione per limitare gli abusi.
    match /sessions/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.lastSeen is timestamp
        && request.resource.data.keys().size() <= 14
        && (!('ua' in request.resource.data)      || request.resource.data.ua.size() <= 400)
        && (!('email' in request.resource.data)   || request.resource.data.email.size() <= 200)
        && (!('name' in request.resource.data)    || request.resource.data.name.size() <= 160)
        && (!('page' in request.resource.data)    || request.resource.data.page.size() <= 300)
        && (!('vid' in request.resource.data)     || request.resource.data.vid.size() <= 60)
        && (!('country' in request.resource.data) || request.resource.data.country.size() <= 8)
        && (!('city' in request.resource.data)    || request.resource.data.city.size() <= 60);
    }

    // Referral — il nuovo utente crea il doc riferendo se stesso come "referred";
    // solo il referrer può leggerlo e segnarlo "credited" (per accreditarsi i punti).
    match /referrals/{id} {
      allow create: if signedIn()
        && request.resource.data.referred == request.auth.uid
        && request.resource.data.referrer != request.auth.uid;
      allow read:   if isAdmin() || (signedIn() && resource.data.referrer == request.auth.uid);
      allow update: if signedIn() && resource.data.referrer == request.auth.uid
        && request.resource.data.referrer == resource.data.referrer
        && request.resource.data.referred == resource.data.referred;
      allow delete: if isAdmin();
    }

    // Spedizione di gruppo — utenti loggati leggono i gruppi (bacheca pubblica
    // + join via codice); l'host crea (con sé come host) ed è l'unico a cambiare
    // i campi diversi da "members"; chiunque loggato può unirsi/uscire (modifica
    // solo il campo members). Cap dimensioni per limitare abusi.
    match /groupOrders/{id} {
      allow read:   if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.keys().size() <= 16
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.members is list && request.resource.data.members.size() <= 30;
      allow update: if signedIn()
        && request.resource.data.members is list && request.resource.data.members.size() <= 30
        && request.resource.data.hostUid == resource.data.hostUid
        && (
             request.auth.uid == resource.data.hostUid
             || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
           );
      allow delete: if isAdmin() || (signedIn() && resource.data.hostUid == request.auth.uid);
    }

    // Recensioni prodotto — lettura pubblica; scrittura solo utenti loggati
    // (una recensione per il proprio account); modifica/eliminazione admin.
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ── Catalogo streaming ──────────────────────────────────────
    // Vetrina pubblica: il browser legge Firestore direttamente, quindi
    // i metadati sono in chiaro per tutti. Scrittura solo admin.
    match /titles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /episodes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sorgenti riproducibili — CHIUSE A OGNI CLIENT, di proposito.
    // Sono l'unica cosa che separa la vetrina dal contenuto: se fossero
    // leggibili, chiunque potrebbe estrarre gli URL con una query dal
    // browser e il login di /streamPlay non servirebbe a niente.
    // Il Worker vi accede col service account, che non passa da qui.
    match /title_sources/{id} {
      allow read, write: if false;
    }

    // Composizione della home (hero e righe dei caroselli)
    match /stream_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Punto di visione — ognuno scrive e legge solo il proprio
    match /progress/{uid}/items/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Watchlist — stessa regola
    match /watchlist/{uid}/items/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
