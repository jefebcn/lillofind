rules_version = '2';
// Deploy automatico via GitHub Actions (firebase-deploy.yml) ad ogni push su main.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin: UN SOLO modello, il token (lo stesso del Worker, lib/auth.js).
    //  - custom claim admin:true (scripts/set-admin-claim.mjs), oppure
    //  - email dell'allowlist, ma solo se VERIFICATA. Prima bastava l'email:
    //    la registrazione email/password non chiede la verifica, quindi chi
    //    registrava per primo un indirizzo della lista non ancora usato
    //    diventava admin.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true
        || (request.auth.token.get('email_verified', false) == true
            && request.auth.token.email in ['yishionvt@gmail.com', 'admin@lillofind.com'])
      );
    }
    // Email del token utilizzabile per dare accesso a dati: solo se verificata.
    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', null) != null;
    }

    // Impedisce all'utente di scriversi isAdmin:true sul proprio documento
    // (difesa in profondità: le regole non lo usano, ma evita confusione).
    function noSelfAdmin() {
      return !('isAdmin' in request.resource.data)
        || request.resource.data.isAdmin == resource.data.get('isAdmin', false);
    }

    // Campi del profilo che il cliente può scrivere da sé. Tutto il resto
    // (lfpoints, activeReward, discountUsed, totalSpent, credenziali,
    // tracking, isAdmin…) lo scrivono SOLO il Worker (service account) o
    // l'admin: prima il browser poteva darsi punti e sconti dalla console.
    function selfUserKeys() {
      return ['uid', 'email', 'displayName', 'phone', 'address', 'addresses',
              'notifications', 'preferredSize', 'preferredBrands', 'birthday',
              'gender', 'language', 'isGuest', 'lastOrderAt', 'createdAt', 'photoURL'];
    }
    function isAnon() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function str(v, max) { return v is string && v.size() <= max; }

    // Products — lettura pubblica, scrittura solo admin
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Costi fornitore e link alla fonte (costEUR, supplierPriceCNY,
    // sourceUrl…): stavano nei documenti pubblici di products. Solo admin.
    match /products_private/{id} {
      allow read, write: if isAdmin();
    }

    // Orders — utente legge i propri (per uid O per email verificata, così vede
    // gli ordini anche se ha cambiato metodo di login mantenendo la stessa
    // email — es. passaggio a "Accedi con Google"); admin legge/scrive tutti.
    // L'email in Firebase Auth è unica per account, quindi il match è sicuro.
    match /orders/{id} {
      // Ogni ramo per email richiede l'email VERIFICATA: prima bastava
      // registrarsi con l'indirizzo di un cliente per leggerne gli ordini.
      allow read:   if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid)
                    || (verifiedEmail() && resource.data.email == request.auth.token.email)
                    // …oppure se il proprietario dell'ordine (il suo uid) è un
                    // account con la mia stessa email verificata: copre il caso
                    // in cui il cliente ha un vecchio account (uid diverso) con
                    // la stessa email, anche se sull'ordine manca il campo email.
                    || (verifiedEmail()
                        && exists(/databases/$(database)/documents/users/$(resource.data.uid))
                        && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.get('email','') == request.auth.token.email);
      // Gli ordini li crea SOLO il Worker (/validateOrder), che ricalcola
      // prezzi, spedizione e sconto dal catalogo: dal browser si potevano
      // scrivere prezzi, totale e stato arbitrari.
      allow create, update, delete: if isAdmin();
    }

    // Users — utente legge/scrive il proprio doc (per uid); legge anche eventuali
    // doc con la propria email verificata (credenziali aggiunte dall'admin su un
    // profilo con lo stesso indirizzo ma uid diverso). La scrittura resta legata
    // all'uid. Email unica in Firebase Auth → lettura per email sicura.
    match /users/{uid} {
      allow read:  if request.auth.uid == uid || isAdmin()
                   || (verifiedEmail() && resource.data.email == request.auth.token.email);
      // Scrittura sul proprio doc; discountUsed è write-once (non azzerabile)
      // così non si può "resettare" lo sconto già usato. Admin bypassa.
      // Creazione: bonus di benvenuto max 50 punti, nessuno sconto/spesa.
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(selfUserKeys().concat(['lfpoints', 'totalSpent']))
        && (!('lfpoints' in request.resource.data) || (request.resource.data.lfpoints is int && request.resource.data.lfpoints >= 0 && request.resource.data.lfpoints <= 50))
        && (!('totalSpent' in request.resource.data) || request.resource.data.totalSpent == 0)
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfUserKeys())
      );
      allow delete: if isAdmin();
    }

    // Richieste prodotto ("non trovo prodotto") — serve un utente (anche
    // ospite anonimo, lo crea il sito: lfAssicuraUtente), solo admin legge.
    // Prima chiunque, senza sessione, poteva caricare foto da 900KB a raffica.
    match /product_requests/{id} {
      // Forma e dimensioni limitate (foto max ~900KB, testi brevi).
      allow create: if signedIn()
        && request.resource.data.get('userId', request.resource.data.get('uid', '')) == request.auth.uid
        && request.resource.data.keys().hasOnly(['note', 'image', 'userId', 'userEmail', 'ts',
            'type', 'sport', 'team', 'year', 'kit', 'category', 'personalization', 'email', 'uid', 'status', 'createdAt'])
        && (!('note' in request.resource.data) || str(request.resource.data.note, 2000))
        && (!('image' in request.resource.data) || request.resource.data.image == null || str(request.resource.data.image, 900000))
        && (!('team' in request.resource.data) || str(request.resource.data.team, 120))
        && (!('email' in request.resource.data) || str(request.resource.data.email, 200))
        && (!('personalization' in request.resource.data) || str(request.resource.data.personalization, 120));
      allow read, update, delete: if isAdmin();
    }

    // Avvisami quando disponibile — serve un utente (anche ospite anonimo),
    // solo admin legge.
    match /stock_alerts/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['productId', 'productName', 'email', 'uid', 'notified', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.productId, 60)
        && str(request.resource.data.email, 200)
        && (!('productName' in request.resource.data) || str(request.resource.data.productName, 300))
        && request.resource.data.get('notified', false) == false;
      allow read, update, delete: if isAdmin();
    }

    // Newsletter — serve un utente (anche ospite anonimo), solo admin legge.
    // Prima mancava del tutto questa regola: ogni iscrizione era rifiutata
    // e il sito diceva comunque «Iscritto!».
    match /newsletter/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'uid', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.email, 200)
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, update, delete: if isAdmin();
    }

    // Analytics presenza — ogni visitatore scrive la propria sessione (heartbeat),
    // solo l'admin legge. Create/update pubblici (anche non loggati) ma con
    // validazione di forma/dimensione per limitare gli abusi.
    match /sessions/{id} {
      allow read, delete: if isAdmin();
      // Ogni campo col suo TIPO, non solo la lunghezza: un array al posto di
      // country passava (size() vale anche per le liste) e mandava in crash
      // admin.html.
      allow create, update: if request.resource.data.lastSeen is timestamp
        && request.resource.data.keys().hasOnly(['vid', 'sid', 'lastSeen', 'startedAt', 'uid', 'email', 'name', 'page', 'country', 'city', 'ua'])
        && (!('ua' in request.resource.data)      || str(request.resource.data.ua, 400))
        && (!('email' in request.resource.data)   || str(request.resource.data.email, 200))
        && (!('name' in request.resource.data)    || str(request.resource.data.name, 160))
        && (!('page' in request.resource.data)    || str(request.resource.data.page, 300))
        && (!('vid' in request.resource.data)     || str(request.resource.data.vid, 60))
        && (!('sid' in request.resource.data)     || str(request.resource.data.sid, 80))
        && (!('uid' in request.resource.data)     || str(request.resource.data.uid, 128))
        && (!('country' in request.resource.data) || str(request.resource.data.country, 8))
        && (!('city' in request.resource.data)    || str(request.resource.data.city, 60))
        && (!('startedAt' in request.resource.data) || request.resource.data.startedAt is timestamp)
        // una sessione esistente non può essere riassegnata a un altro visitatore
        && (resource == null || !('vid' in resource.data) || request.resource.data.get('vid', '') == resource.data.vid);
    }

    // Referral — il nuovo utente crea il doc riferendo se stesso come "referred";
    // solo il referrer può leggerlo e segnarlo "credited" (per accreditarsi i punti).
    match /referrals/{id} {
      // L'accredito dei punti lo fa il Worker (/claimReferrals), non il browser.
      allow create: if signedIn() && !isAnon()
        && request.resource.data.keys().hasOnly(['referrer', 'referred', 'credited', 'createdAt'])
        && request.resource.data.referred == request.auth.uid
        && str(request.resource.data.referrer, 128)
        && request.resource.data.referrer != request.auth.uid
        && request.resource.data.get('credited', false) == false;
      allow read:   if isAdmin() || (signedIn() && resource.data.referrer == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Spedizione di gruppo.
    //  - LISTA: solo i gruppi pubblici, o quelli di cui sei host/membro
    //    (memberUids). Prima chiunque fosse loggato, anche anonimo, leggeva
    //    tutti i gruppi privati con codice, membri e note.
    //  - GET per id: chi lo conosce. I gruppi nuovi hanno id = codice (LFxxxxxx):
    //    conoscere il codice e' esattamente il permesso di entrare.
    //  - Tipi controllati: maxPeople intero 2..30, codice LF+6, visibilita' e
    //    stato da un elenco. Prima maxPeople poteva essere HTML e finiva nella
    //    bacheca degli altri (XSS).
    function groupShapeOk(d) {
      return d.keys().size() <= 18
        && d.hostUid is string
        && d.title is string && d.title.size() <= 120
        && (!('area' in d) || str(d.area, 80))
        && (!('note' in d) || str(d.note, 300))
        && (!('deadline' in d) || (d.deadline is string && d.deadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$|^$')))
        && (!('hostName' in d) || str(d.hostName, 80))
        && d.code is string && d.code.matches('^LF[A-Z0-9]{6}$')
        && d.maxPeople is int && d.maxPeople >= 2 && d.maxPeople <= 30
        && d.visibility in ['public', 'private']
        && d.status in ['open', 'closed']
        && d.members is list && d.members.size() <= 30
        && (!('memberUids' in d) || (d.memberUids is list && d.memberUids.size() <= 30));
    }
    match /groupOrders/{id} {
      allow get: if signedIn();
      allow list: if signedIn() && (
        resource.data.visibility == 'public'
        || resource.data.hostUid == request.auth.uid
        || request.auth.uid in resource.data.get('memberUids', [])
      );
      allow create: if signedIn() && !isAnon()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code == id
        && groupShapeOk(request.resource.data);
      // L'host gestisce il gruppo (ma il codice non cambia); gli altri possono
      // solo AGGIUNGERE o TOGLIERE se stessi da members e memberUids.
      allow update: if signedIn()
        && groupShapeOk(request.resource.data)
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.code == resource.data.code
        && (
             request.auth.uid == resource.data.hostUid
             || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
                 && (
                      // entra: lista vecchia + 1 elemento che è se stesso
                      (request.resource.data.members.size() == resource.data.members.size() + 1
                        && request.resource.data.members.hasAll(resource.data.members)
                        && request.resource.data.members[resource.data.members.size()].uid == request.auth.uid
                        && request.resource.data.get('memberUids', []).hasAll(resource.data.get('memberUids', []))
                        && request.resource.data.get('memberUids', []).removeAll(resource.data.get('memberUids', [])).hasOnly([request.auth.uid]))
                      // esce: tolto esattamente un elemento, il proprio
                      || (request.resource.data.members.size() == resource.data.members.size() - 1
                        && resource.data.members.hasAll(request.resource.data.members)
                        && resource.data.members.removeAll(request.resource.data.members).size() == 1
                        && resource.data.members.removeAll(request.resource.data.members)[0].uid == request.auth.uid
                        && resource.data.get('memberUids', []).hasAll(request.resource.data.get('memberUids', []))
                        && resource.data.get('memberUids', []).removeAll(request.resource.data.get('memberUids', [])).hasOnly([request.auth.uid]))
                    ))
           );
      allow delete: if isAdmin() || (signedIn() && resource.data.hostUid == request.auth.uid);
    }

    // Recensioni prodotto — lettura pubblica; scrittura solo utenti loggati.
    // UNA per utente e prodotto (id = uid_productId) e col nome del proprio
    // account: prima se ne potevano postare quante si voleva, con qualsiasi
    // nome. Modifica/eliminazione admin.
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && !isAnon()
        && request.resource.data.keys().hasOnly(['productId', 'userId', 'userName', 'rating', 'text', 'photo', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && str(request.resource.data.productId, 60)
        && id == request.auth.uid + '_' + request.resource.data.productId
        && (!('userName' in request.resource.data)
            || request.resource.data.userName == request.auth.token.get('name', '')
            || request.resource.data.userName == string(request.auth.token.get('email', '')).split('@')[0])
        && (!('text' in request.resource.data) || str(request.resource.data.text, 600))
        && (!('photo' in request.resource.data) || str(request.resource.data.photo, 400000))
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ── Catalogo streaming ──────────────────────────────────────
    // Vetrina pubblica: il browser legge Firestore direttamente, quindi
    // i metadati sono in chiaro per tutti. Scrittura solo admin.
    match /titles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /episodes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sorgenti riproducibili — CHIUSE A OGNI CLIENT, di proposito.
    // Sono l'unica cosa che separa la vetrina dal contenuto: se fossero
    // leggibili, chiunque potrebbe estrarre gli URL con una query dal
    // browser e il login di /streamPlay non servirebbe a niente.
    // Il Worker vi accede col service account, che non passa da qui.
    match /title_sources/{id} {
      allow read, write: if false;
    }

    // Composizione della home (hero e righe dei caroselli)
    match /stream_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Punto di visione — ognuno scrive e legge solo il proprio
    match /progress/{uid}/items/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Watchlist — stessa regola
    match /watchlist/{uid}/items/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
